# https://jvns.ca/blog/2024/02/16/popular-git-config-options/
[user]
	name = crbelaus
	email = cristian@crbelaus.com
[core]
	excludesfile = ~/.config/git/global_gitignore
	editor = nvim
[merge]
	# Disable fast forward merges, forcing a merge commit.
	ff = false
	# Use zdiff3 style for conflict resolution, which provides more context
	conflictstyle = zdiff3
[branch]
	# Automatically set up new branches to rebase instead merge when pulling
	autosetuprebase = always
[pager]
	# Disable pagination for the git branch command
	branch = false
    # Use a pager if the difftool output is larger than one screenful,
    # consistent with the behaviour of `git diff`.
    difftool = true
[diff]
	# Use the histogram algorithm for generating diffs, which is often more accurate
	algorithm = histogram
    # Set difftastic as the default difftool, so we don't need to specify
    # `-t difftastic` every time.
    tool = difftastic
[difftool "difftastic"]
    # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[difftool]
    # Run the difftool immediately without asking if I am sure
    prompt = false
[protocol]
	# Git protocol version 2 is more efficient
	version = 2
[init]
	# Use `main` as the default branch name when initializing a repository
	# https://git-scm.com/docs/git-init#Documentation/git-init.txt-initdefaultBranch
	defaultBranch = main
[rebase]
	# Autosquash fixup commits automatically when rebasing
	# https://git-scm.com/docs/git-rebase#Documentation/git-rebase.txt-rebaseautoSquash
	autoSquash = true
[push]
	# Push the current branch to the branch with the same name on the remote
	# https://git-scm.com/docs/git-push#Documentation/git-push.txt-pushdefault
	default = current
