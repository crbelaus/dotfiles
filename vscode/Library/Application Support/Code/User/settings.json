{
  // === Editor ===
  "editor.bracketPairColorization.enabled": true,
  "editor.fontFamily": "Iosevka, Jetbrains Mono, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 17,
  "editor.inlineSuggest.enabled": true,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.tabSize": 2,
  "editor.trimAutoWhitespace": true,
  "editor.wordWrap": "on",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.guides.indentation": false,

  // === Breadcrumbs ===
  "breadcrumbs.enabled": false,

  // === Terminal ===
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "terminal.integrated.fontSize": 16,

  // === Workbench ===
  "workbench.commandPalette.preserveInput": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.labelFormat": "medium",
  "workbench.enableExperiments": false,
  "workbench.quickOpen.preserveInput": true,
  "workbench.settings.editor": "json",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.activityBar.visible": false,
  "workbench.preferredDarkColorTheme": "Atom One Dark",
  "workbench.preferredLightColorTheme": "Atom One Light",
  "workbench.colorTheme": "Atom One Dark",

  // === Files ===
  "files.exclude": {
    "**/_build": true,
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/CVS": true
  },
  "files.hotExit": "onExitAndWindowClose",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,

  // === Explorer ===
  "explorer.autoReveal": false,

  // === Search ===
  "search.exclude": {
    "**/deps": true,
    "**/node_modules": true
  },

  // === Emmet ===
  "emmet.includeLanguages": {
    "phoenix-heex": "html"
  },

  // === Languages: Elixir ===
  "lexical.server.releasePathOverride": "/Users/crbelaus/Developer/lexical/_build/dev/rel/lexical",
  "files.associations": {
    "*.html.heex": "phoenix-heex"
  },
  "[elixir]": {
    "editor.rulers": [
      100
    ],
    "editor.formatOnSave": true
  },
  "[phoenix-heex]": {
    "editor.formatOnSave": true
  },

  // === Languages: Markdown ===
  "[markdown]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 80,
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    }
  },

  // === Languages: CSV ===
  "[csv]": {
    "editor.wordWrap": "off"
  },

  // === Languages: Git Commit ===
  "[git-commit]": {
    "editor.rulers": [
      50,
      72
    ],
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    }
  },

  // === Git ===
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.defaultDateStyle": "absolute",
  "git.mergeEditor": false
}
