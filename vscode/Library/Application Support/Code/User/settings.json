{
  // Editor
  "editor.rulers": [80, 98],
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.fontSize": 14,
  "editor.cursorStyle": "block",
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.fontFamily": "JetBrains Mono, Menlo, Monaco, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.smoothScrolling": true,

  // Breadcrumbs
  "breadcrumbs.enabled": false,

  // Terminal
  "terminal.integrated.fontSize": 15,
​
  // Window
  "window.titleBarStyle": "custom",

  // Workbench
  "workbench.settings.editor": "json",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.commandPalette.preserveInput": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.labelFormat": "medium",
  "workbench.enableExperiments": false,
  "workbench.quickOpen.preserveInput": true,
​
  // Files
  "files.insertFinalNewline": true,
  "files.hotExit": "onExitAndWindowClose",
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/_build": true,
    "**/.vscode": true,
    "**/.elixir_ls": true
  },

  // Explorer
  "explorer.openEditors.visible": 0,
  "explorer.autoReveal": false,
​
  // Search
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/deps": true,
    "**/uploads": true,
    "vendor/bundle": true
  },
  // "search.mode": "newEditor",
  // "search.searchEditor.defaultNumberOfContextLines": 2,
  // "search.searchEditor.doubleClickBehaviour": "openLocationToSide",
​
  // Emmet
  "emmet.includeLanguages": {
    "html-eex": "html",
    "phoenix-heex": "html",
  },
​
  // Elixir
  "[elixir]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.wordBasedSuggestions": false,
    "editor.formatOnType": true,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "editor.formatOnSave": true,
    "editor.rulers": [98]
  },
  "elixirLS.dialyzerEnabled": false,
  "elixirLS.suggestSpecs": false,
  "elixirLS.fetchDeps": false,

  "[markdown]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 80,
    "editor.quickSuggestions": false,
    "files.trimTrailingWhitespace": false
  },

  // JSON
  "json.format.enable": false,

  "gitlens.codeLens.enabled": false,
  "gitlens.defaultDateStyle": "absolute",

  "[git-commit]": {
    "editor.rulers": [50, 72]
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.inlineSuggest.enabled": true,
  "workbench.colorTheme": "Monokai",
  "gitlens.mode.active": "review",
  "workbench.activityBar.visible": false,
  "diffEditor.renderSideBySide": false,
  "githubPullRequests.fileListLayout": "flat",

  "vscodeMarkdownNotes.workspaceFilenameConvention": "relativePaths"
}
